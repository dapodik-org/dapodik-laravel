{
  "name": "dapodik-org/dapodik-laravel",
  "description": "Dapodik Laravel — Monorepo",
  "keywords": ["dapodik", "dapodik-org", "laravel", "dapodik-laravel"],
  "license": "MIT",
  "authors": [
    {
      "name": "Dapodik Org",
      "email": "org.dapodik@gmail.com",
      "role": "Developer"
    },
    {
      "name": "Ade Reksi Susanto",
      "email": "adereksisusanto@gmail.com",
      "role": "Developer"
    }
  ],
  "replace": {
    "dapodik-org/dapodik-laravel-eloquent": "self.version",
    "dapodik-org/dapodik-laravel-api": "self.version"
  },
  "autoload": {
    "psr-4": {
      "Dapodik\\Laravel\\": "src/laravel/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Dapodik\\Laravel\\Eloquent\\Tests\\": "tests/Eloquent/",
      "Dapodik\\Laravel\\API\\Tests\\": "tests/API/"
    }
  },
  "require": {
    "php": ">=8.1",
    "guzzlehttp/guzzle": "^7.0",
    "illuminate/support": "^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0",
    "illuminate/database": "^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0",
    "illuminate/console": "^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0",
    "illuminate/contracts": "^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0",
    "illuminate/filesystem": "^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0"
  },
  "require-dev": {
    "doctrine/dbal": "^3.5",
    "laravel/pint": "^1.0",
    "orchestra/testbench": "^8.0 || ^9.0 || ^10.0 || ^11.0",
    "pestphp/pest": "^2.0",
    "phpstan/phpstan": "^1.0"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Dapodik\\Laravel\\Eloquent\\EloquentServiceProvider",
        "Dapodik\\Laravel\\API\\APIServiceProvider"
      ],
      "aliases": {
        "Eloquent": "Dapodik\\Laravel\\Eloquent\\Facades\\Eloquent",
        "API": "Dapodik\\Laravel\\API\\Facades\\API"
      }
    }
  },
  "scripts": {
    "test:eloquent": "@php vendor/bin/pest --testsuite Eloquent",
    "test:api": "@php vendor/bin/pest --testsuite API",
    "test": [
      "@test:eloquent",
      "@test:api"
    ],
    "lint": "@php vendor/bin/pint --test",
    "cs-fix": "@php vendor/bin/pint",
    "analyse": "@php vendor/bin/phpstan analyse --memory-limit=-1",
    "check": [
      "@lint",
      "@analyse",
      "@test"
    ]
  },
  "config": {
    "process-timeout": 600,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    },
    "audit": {
      "block-insecure": false
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
